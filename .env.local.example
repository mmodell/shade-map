# ---- Client (exposed in the browser bundle — this is normal for Google Maps JS) ----
# Create at https://console.cloud.google.com/  →  enable "Maps JavaScript API",
# "Directions API", "Places API (New)", "Geocoding API", "Elevation API".
# Restrict the key to your domains (localhost:5173 and your-app.vercel.app)
# under "HTTP referrers".
VITE_GOOGLE_MAPS_API_KEY=

# ---- Server only (never shipped to the browser) ----
# Free key from https://openweathermap.org/api  ("Current Weather" + "5 day / 3 hour forecast").
# Optional: if left blank, the app still ranks routes but skips the weather timeline.
OPENWEATHER_API_KEY=

# Optional: units for the weather timeline — "imperial" (°F/mph) or "metric" (°C/m/s).
WEATHER_UNITS=imperial

# Optional: free key from https://api.data.gov/signup/ — enables a small,
# state-level "is this area generally safer/riskier than average" nudge on
# the Safety score, from the FBI's public Crime Data Explorer API. This is
# coarse (statewide, not block-level) because no free source covers arbitrary
# US addresses more precisely. Leave blank to skip it — Safety still works
# off sidewalks/lighting/road data either way.
FBI_CRIME_API_KEY=
